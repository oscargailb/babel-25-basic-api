  "components": {
    "schemas": {
      "Plato": {
        "type": "object",
        "description": "Objeto Plato con los detalles del plato a crear",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32",
            "description": "ID único del plato"
          },
          "nombre": {
            "type": "string",
            "description": "Nombre del plato"
          },
          "precio": {
            "type": "number",
            "format": "double",
            "description": "Precio del plato",
            "example": 12.5
          },
          "categoria": {
            "type": "string",
            "description": "Categoria del plato, indicando si es primer plato, segundo plato o postre.",
            "enum": [
              "Entrante",
              "Plato principal",
              "Postre"
            ],
            "example": "PRIMER_PLATO"
          }
        },
        "required": [
          "id"
        ]
      },
      "Local": {
        "type": "object",
        "description": "Datos del local a crear o actualizar",
        "properties": {
          "cif": {
            "type": "string",
            "description": "CIF único del local",
            "example": "B12345678"
          },
          "nombre": {
            "type": "string",
            "description": "Nombre del local"
          },
          "direccion": {
            "type": "string",
            "description": "Dirección física del local"
          },
          "telefono": {
            "type": "string",
            "description": "Teléfono del local"
          },
          "carta": {
            "type": "array",
            "description": "Lista de platos disponibles en el local",
            "items": {
              "$ref": "#/components/schemas/Plato"
            }
          }
        },
        "required": [
          "cif"
        ]
      }
    }
